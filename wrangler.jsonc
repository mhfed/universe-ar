{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-hero-hand-studio",
  "main": "./backend/worker.mjs",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "TRY_ON_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 2, "period": 60 }
    }
  ]
}
